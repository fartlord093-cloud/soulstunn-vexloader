local isfile = isfile or function(file)
    local suc, res = pcall(function() return readfile(file) end)
    return suc and res ~= nil and res ~= ''
end

local cloneref = cloneref or function(ref) return ref end
local delfile = delfile or function(file) writefile(file, '') end

local Watermark = '--This watermark is used to delete the file if its cached, remove it to make the file persist after VexLoader updates.'

--[[=====================================================================
    UNIVERSAL HTTP GET - WORKS ON ANY EXECUTOR
=====================================================================]]
local function universalHttpGet(url)
    local result = nil
    
    -- METHOD 1: game:HttpGet
    if not result then
        pcall(function()
            result = game:HttpGet(url, true)
        end)
        if result and result ~= "" then
            print("[VexLoader] Downloaded via game:HttpGet")
            return result
        end
    end
    
    -- METHOD 2: syn.request
    if not result then
        pcall(function()
            if syn and syn.request then
                local response = syn.request({
                    Url = url,
                    Method = "GET",
                })
                if response and response.Body and response.Body ~= "" then
                    result = response.Body
                end
            end
        end)
        if result and result ~= "" then
            print("[VexLoader] Downloaded via syn.request")
            return result
        end
    end
    
    -- METHOD 3: request
    if not result then
        pcall(function()
            if request then
                local response = request({
                    Url = url,
                    Method = "GET",
                })
                if response and response.Body and response.Body ~= "" then
                    result = response.Body
                end
            end
        end)
        if result and result ~= "" then
            print("[VexLoader] Downloaded via request")
            return result
        end
    end
    
    -- METHOD 4: http.request
    if not result then
        pcall(function()
            if http and http.request then
                result = http.request(url)
            end
        end)
        if result and result ~= "" then
            print("[VexLoader] Downloaded via http.request")
            return result
        end
    end
    
    return nil
end

--[[=====================================================================
    ENHANCED DOWNLOAD FUNCTION
=====================================================================]]
local function downloadFile(path, func)
    if not isfile(path) then
        local relPath = select(1, path:gsub('vexloader/', ''))
        local isBedwars = relPath == 'games/bedwars.lua'
        local content
        
        -- Try multiple sources
        local sources = {
            -- Primary: GitHub raw (soulstunn)
            function()
                if isBedwars then
                    return universalHttpGet('https://gitlab.com/soulstunn/vexloader/-/raw/main/bedwars.lua')
                end
                return universalHttpGet('https://raw.githubusercontent.com/soulstunn/vexloader/main/' .. relPath)
            end,
            -- Fallback: jsdelivr CDN
            function()
                return universalHttpGet('https://cdn.jsdelivr.net/gh/soulstunn/vexloader@main/' .. relPath)
            end,
            -- Fallback: GitLab
            function()
                return universalHttpGet('https://gitlab.com/soulstunn/vexloader/-/raw/main/' .. relPath)
            end,
        }
        
        for attempt = 1, 4 do
            for _, sourceFunc in ipairs(sources) do
                local suc, res = pcall(sourceFunc)
                if suc and res and res ~= '' and res ~= '404: Not Found' then
                    if not path:find('.lua') or loadstring(res) ~= nil then
                        content = res
                        print('[VexLoader] Downloaded ' .. path .. ' (attempt ' .. attempt .. ')')
                        break
                    end
                end
            end
            if content then break end
            if attempt < 4 then
                task.wait(attempt)
            end
        end
        
        if not content then
            error('failed to download ' .. path .. ' after 4 attempts')
        end
        
        if path:find('.lua') then
            content = Watermark .. '\n' .. content
        end
        writefile(path, content)
    end
    return (func or readfile)(path)
end

-- Fetches the GitHub profiles folder listing
local function fetchProfilesListing(ref)
    local reqSuc, res = pcall(function()
        return game:HttpGet('https://api.github.com/repos/soulstunn/vexloader/contents/profiles' .. (ref and ('?ref=' .. ref) or ''), true)
    end)
    if not (reqSuc and res and res ~= '404: Not Found') then return nil end
    local bodySuc, body = pcall(function()
        return cloneref(game:GetService('HttpService')):JSONDecode(res)
    end)
    if not (bodySuc and body and typeof(body) == 'table') then return nil end
    return body
end

-- Merge GUI state to preserve custom profiles
local function mergeGuiState(path, incoming)
    if not path:find('%.gui%.txt$') then return incoming end
    local ok, merged = pcall(function()
        local httpService = cloneref(game:GetService('HttpService'))
        local new = httpService:JSONDecode(incoming)
        if type(new) ~= 'table' then return incoming end
        if isfile(path) then
            local old = httpService:JSONDecode(readfile(path))
            if type(old) == 'table' then
                if old.Profiles ~= nil then new.Profiles = old.Profiles end
                if old.Profile ~= nil then new.Profile = old.Profile end
            end
        end
        return httpService:JSONEncode(new)
    end)
    return (ok and type(merged) == 'string') and merged or incoming
end

-- Download profiles listing concurrently
local function downloadProfilesListing(body, commit, onProgress)
    local files = {}
    for _, v in body do
        if v.type == 'file' then
            table.insert(files, v)
        end
    end
    local completed, pending, total = 0, #files, #files
    local done = Instance.new('BindableEvent')
    for _, v in files do
        local relPath = ({v.path:gsub(' ', '%%20')})[1]
        task.spawn(function()
            if commit then
                pcall(function()
                    for attempt = 1, 4 do
                        local suc, res = pcall(function()
                            return game:HttpGet('https://raw.githubusercontent.com/soulstunn/vexloader/' .. commit .. '/' .. relPath, true)
                        end)
                        if suc and res and res ~= '' and res ~= '404: Not Found' then
                            writefile('vexloader/' .. relPath, mergeGuiState('vexloader/' .. relPath, res))
                            break
                        end
                        if attempt < 4 then
                            task.wait(attempt)
                        end
                    end
                end)
            else
                pcall(downloadFile, 'vexloader/' .. relPath)
            end
            completed += 1
            pending -= 1
            if onProgress then
                onProgress(completed, total)
            end
            if pending <= 0 then
                done:Fire()
            end
        end)
    end
    if pending > 0 then
        done.Event:Wait()
    end
    done:Destroy()
end

